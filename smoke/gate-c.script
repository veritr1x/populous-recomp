# Wide-view gameplay scenario for Level 2001.
# With the camera at (4600,59000), brave 1828 lies outside the Classic
# scene and inside the expanded scene. Selection/movement follows shaman 1815.
# Run with a pinned clock and record new evidence for the current build;
# the expected landmark does not establish correctness without the assertions.
# POP_RECOMP_PIN_CLOCK=1 POP_SMOKE_DRAWABLE=3840x2160 POP_SMOKE_SIM_REGIONS=1
# LANDMARK=visible with a widened Enhanced scene; otherwise LANDMARK=hidden.
await picture>0.98 for 2000 within 60000
dump menu

# New Game, then answer No to the tutorial prompt.
moveby -2000 -2000
wait 400
moveby 320 140
wait 700
click left 320 140
wait 3000
moveby -2000 -2000
wait 400
moveby 320 219
wait 700
click left 320 219
wait 12000
dump levelselect

# Start mission 01 from the panel's button.
moveby -2000 -2000
wait 300
moveby 605 448
wait 900
click left 605 448
wait 8000
dump level_start

simdump level_start

# Dismiss the opening dialogue.
moveby -2000 -2000
wait 300
moveby 236 148
wait 700
click left 236 148
wait 4000
dump level_playing

# M1's first actions: select blue shaman 1815, then order it to walk,
# and check both against the game's own record rather than against pixels.
#
# WHY NOT PIXELS
#
# The level opens in a camera flyby, and while it runs every frame differs from
# the last whatever the player does - so "the picture changed" cannot tell a
# selected brave from an ignored click. The entity table can. It is 2000
# records of 179 bytes at 0x8e0428, laid out as games/populous/tests/entity_codec.hpp encodes
# it: flags at +12, kind at +42, state at +44, owner at +47, position at +61 as
# x, z and altitude words. A blue brave is owner 0, kind 1.
#
# THE FLYBY
#
# This waits a fixed 20 seconds for it, and says so rather than pretending to
# detect it: there is no camera-settle signal exposed to the host, and a
# frame-difference test cannot find one because the units keep animating after
# the camera stops.
wait 34000
dump flyby_over

# What the game thinks is on the map. The peek is the whole entity table's
# first record, printed and decoded, so a run that finds nothing to watch shows
# what it was looking at instead of only saying that it failed.
# Pin the starting camera, then let a frame record the shaman's own draw.
camera 5386 55651
peek 0x8e0428 179
watch 0 1
wait 800
# Both LANDMARK arms execute exactly these semantic inputs. The centre comes
# from entity 1815's attributed body, excluding the shadow below its feet.
# Missing current-frame attribution fails the run instead of guessing a pixel.
move entity 1815
wait 800
click entity 1815
wait 1500
dump selected
simdump selected
# Two cells east of the initial shaman: world x/z/altitude, not screen offsets.
# The saved entity evidence has no entity at this destination. The current
# matrix, zoom, curvature, centre and attributed HUD origin map it at execution.
# Match level1.script: move, settle 800 ms (16 pinned presents), then left
# click with the normal 120 ms / minimum four-present hold. Selection has
# 1500 + 800 ms (46 pinned presents) to register before this world order.
move world 5376 55040 128
wait 800
click world 5376 55040 128
# Let the selected shaman finish its ordinary input-driven walk, then place
# the recorded fixture camera before either dump; brave 1828 is the landmark.
await turn>=780 within 120000
camera 4600 59000
# Deterministic scheduler anchors for this scripted scenario:
# t1 on/off=838/839, t2=878/879. Both arms use 840/880, beyond those values.
# Capture the first completed present >= each anchor; compare ACTUAL counters.
# POP_SMOKE_SIM_REGIONS=1 makes dumpat write entities.json and region binaries.
dumpat gate_c_t1 command_frame>=840
await command_frame>=841 within 120000
dumpat gate_c_t2 command_frame>=880
await command_frame>=881 within 120000
# Evaluate this scheduler point; waiting for a verdict would shift only one arm.
landmark 1828 expect $LANDMARK within 0
expect textures>0
expect draws>0
expect watch_found>0
expect watch_selected>0
expect watch_moved>256
quit
